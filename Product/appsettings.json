{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8084;http://0.0.0.0:9898",
  "ConnectionStrings": {
    "ProductDb": "mongodb://${PRODUCT_DB_USER}:${PRODUCT_DB_PASSWORD}@${PRODUCT_DB_HOST}:${PRODUCT_DB_PORT}"
  },
  "MongoDB": {
    "DatabaseName": "${PRODUCT_DB_NAME}"
  },
  "RabbitMQ": {
    "Host": "${RABBITMQ_HOST}",
    "Port": "${RABBITMQ_PORT}",
    "Username": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}"
  },
  "Zipkin": {
    "Endpoint": "${ZIPKIN_BASE}/api/v2/spans"
  }
}
