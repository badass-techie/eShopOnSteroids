{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8083",
  "ConnectionStrings": {
    "OrderDb": "Host=${ORDER_DB_HOST};Port=${ORDER_DB_PORT};Database=${ORDER_DB_NAME};Username=${ORDER_DB_USER};Password=${ORDER_DB_PASSWORD}"
  },
  "Grpc": {
    "ProductServiceUrl": "${PRODUCT_MICROSERVICE_URL}"
  },
  "RabbitMQ": {
    "Host": "${RABBITMQ_HOST}",
    "Port": "${RABBITMQ_PORT}",
    "Username": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}"
  },
  "Zipkin": {
    "Endpoint": "${ZIPKIN_BASE}/api/v2/spans"
  }
}
