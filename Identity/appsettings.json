{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8082",
  "ConnectionStrings": {
    "IdentityDb": "Host=${IDENTITY_DB_HOST};Port=${IDENTITY_DB_PORT};Database=${IDENTITY_DB_NAME};Username=${IDENTITY_DB_USER};Password=${IDENTITY_DB_PASSWORD}"
  },
  "Jwt": {
    "Issuer": "eShopOnSteroids",
    "Audience": "eShopOnSteroids",
    "AccessTokenExpiration": 3600,
    "RefreshTokenExpiration": 2592000
  },
  "Rsa": {
    "PublicKeyPath": "certs/public.pem",
    "PrivateKeyPath": "certs/private.pem"
  },
  "Zipkin": {
    "Endpoint": "${ZIPKIN_BASE}/api/v2/spans"
  }
}
