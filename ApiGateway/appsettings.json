{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8080",
  "Jwt": {
    "Issuer": "eShopOnSteroids",
    "Audience": "eShopOnSteroids"
  },
  "Rsa": {
    "PublicKeyPath": "certs/public.pem"
  },
  "Zipkin": {
    "Endpoint": "${ZIPKIN_BASE}/api/v2/spans"
  },
  "ReverseProxy": {
    "Routes": {
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/v{version}/product/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v{version}/order/{**catch-all}"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v{version}/identity/{segment}/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/v{version}/cart/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "${PRODUCT_MICROSERVICE_URL}"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "${ORDER_MICROSERVICE_URL}"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "${IDENTITY_MICROSERVICE_URL}"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "${CART_MICROSERVICE_URL}"
          }
        }
      }
    }
  }
}
